<?xml version="1.0" encoding="utf-8"?>
<!--
     Mixer paths for the curtana sm8250-machine card on mainline Linux 6.18.
     The controls and values are the ones verified on the device with the
     miatoll-6.18 RAM-test script miatoll/boot/audio-path, which follows the
     sm7125-mainline miatoll UCM (alsa-ucm-conf 059aa77e, ucm2/Xiaomi/miatoll).
     The HAL applies a path while its PCM is open and resets it on standby.
-->
<mixer>
    <!-- MultiMedia1 (PCM 0) -> TERT_MI2S -> TAS2562 -->
    <path name="speaker">
        <ctl name="ASI1 Sel" value="LeftRightDiv2" />
        <ctl name="Digital Volume Control" value="109" />
        <ctl name="TERT_MI2S_RX Audio Mixer MultiMedia1" value="1" />
    </path>

    <!-- MultiMedia2 (PCM 1) -> RX_CODEC_DMA_RX_0 -> RX macro -> WCD937x HPH -->
    <path name="headphones">
        <ctl name="HPHL Volume" value="2" />
        <ctl name="HPHR Volume" value="2" />
        <ctl name="RX_RX0 Digital Volume" value="84" />
        <ctl name="RX_RX1 Digital Volume" value="84" />
        <ctl name="RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia2" value="1" />
        <ctl name="RX_HPH PWR Mode" value="LOHIFI" />
        <ctl name="RX HPH Mode" value="CLS_H_ULP" />
        <ctl name="RX_MACRO RX0 MUX" value="AIF1_PB" />
        <ctl name="RX_MACRO RX1 MUX" value="AIF1_PB" />
        <ctl name="RX INT0_1 MIX1 INP0" value="RX0" />
        <ctl name="RX INT1_1 MIX1 INP0" value="RX1" />
        <ctl name="RX INT0 DEM MUX" value="CLSH_DSM_OUT" />
        <ctl name="RX INT1 DEM MUX" value="CLSH_DSM_OUT" />
        <ctl name="RX_COMP1 Switch" value="1" />
        <ctl name="RX_COMP2 Switch" value="1" />
        <ctl name="HPHL_RDAC Switch" value="1" />
        <ctl name="HPHR_RDAC Switch" value="1" />
        <ctl name="HPHL Switch" value="1" />
        <ctl name="HPHR Switch" value="1" />
    </path>

    <!-- Bottom microphone (audio-path mic1): TX macro DEC0 -> TX_CODEC_DMA_TX_3
         -> MultiMedia3 (PCM 2) -->
    <path name="builtin-mic">
        <ctl name="TX_DEC0 Volume" value="84" />
        <ctl name="ADC1 Volume" value="12" />
        <ctl name="ADC2 Volume" value="12" />
        <ctl name="MultiMedia3 Mixer TX_CODEC_DMA_TX_3" value="1" />
        <ctl name="TX DEC0 MUX" value="SWR_MIC" />
        <ctl name="TX SMIC MUX0" value="ADC0" />
        <ctl name="TX_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="ADC1_MIXER Switch" value="1" />
        <ctl name="ADC1 Switch" value="1" />
    </path>

    <!-- Headset microphone: curtana's Android amic2 path (ADC2, INP2, DEC0_BCS) -->
    <path name="headset-mic">
        <ctl name="TX_DEC0 Volume" value="84" />
        <ctl name="ADC1 Volume" value="12" />
        <ctl name="ADC2 Volume" value="12" />
        <ctl name="MultiMedia3 Mixer TX_CODEC_DMA_TX_3" value="1" />
        <ctl name="TX DEC0 MUX" value="SWR_MIC" />
        <ctl name="TX SMIC MUX0" value="ADC2" />
        <ctl name="TX_AIF1_CAP Mixer DEC0" value="1" />
        <ctl name="DEC0_BCS Switch" value="1" />
        <ctl name="ADC2_MIXER Switch" value="1" />
        <ctl name="ADC2 Switch" value="1" />
        <ctl name="ADC2 MUX" value="INP2" />
    </path>
</mixer>
